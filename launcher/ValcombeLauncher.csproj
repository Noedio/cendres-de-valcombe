<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValcombeLauncher</AssemblyName>
    <RootNamespace>Valcombe.Launcher</RootNamespace>
    <Version>0.3.0</Version>
    <Product>Les Cendres de Valcombe</Product>
    <ApplicationIcon>Assets\valcombe.ico</ApplicationIcon>
    <!-- Un seul .exe portable, sans installation ni .NET préinstallé -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\valcombe.ico" />
  </ItemGroup>

</Project>
