<Window x:Class="Valcombe.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Les Cendres de Valcombe" Width="980" Height="620" MinWidth="880" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="False"
        Background="{StaticResource Shell}" WindowStartupLocation="CenterScreen"
        Icon="Assets/valcombe.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barre de gauche : blason et navigation -->
    <Border Grid.Column="0" Background="#1E1216" BorderBrush="{StaticResource Bronze}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,22,0,18" MouseLeftButtonDown="DragWindow" Background="Transparent">
          <Image Source="Assets/logo.png" Width="92" Height="92" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <TextBlock Text="Les Cendres" FontFamily="{StaticResource Title}" FontSize="20" Foreground="{StaticResource Gold}"
                     HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock Text="de Valcombe" FontFamily="{StaticResource Title}" FontSize="16" Foreground="{StaticResource ParchDark}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{StaticResource Ash}" FontSize="11"
                   Margin="18,0,0,12"/>
        <StackPanel>
          <RadioButton Style="{StaticResource Nav}" Content="Accueil" x:Name="NavHome" IsChecked="True" Checked="Navigate" Tag="Home"/>
          <RadioButton Style="{StaticResource Nav}" Content="Options du jeu" Checked="Navigate" Tag="Game"/>
          <RadioButton Style="{StaticResource Nav}" Content="Personnalisation" Checked="Navigate" Tag="Look"/>
          <RadioButton Style="{StaticResource Nav}" Content="Réglages" Checked="Navigate" Tag="Settings"/>
          <RadioButton Style="{StaticResource Nav}" Content="Compte" Checked="Navigate" Tag="Account"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Zone principale -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="Backdrop" Grid.RowSpan="3"/>

      <!-- Barre de titre maison -->
      <DockPanel Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="—" Width="40" Click="Minimize" Background="Transparent" Foreground="{StaticResource ParchDark}" BorderThickness="0" Cursor="Hand"/>
          <Button Content="✕" Width="40" Click="CloseWindow" Background="Transparent" Foreground="{StaticResource ParchDark}" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        <TextBlock/>
      </DockPanel>

      <!-- Panneau de parchemin -->
      <Border Grid.Row="1" Margin="24,4,24,12" BorderBrush="{StaticResource Bronze}" BorderThickness="2" CornerRadius="4">
        <Border.Background>
          <ImageBrush ImageSource="Assets/parchment.png" Stretch="UniformToFill"/>
        </Border.Background>
        <Grid Margin="28,22">

          <!-- Accueil -->
          <Grid x:Name="PageHome">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Bienvenue à Valcombe"/>
              <TextBlock Style="{StaticResource Hint}" FontSize="13"
                         Text="Un bourg maudit, un Démon caché parmi vous. Le jour, on débat et on vote ; la nuit, chacun se terre chez soi."/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="230"/>
              </Grid.ColumnDefinitions>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Nouvelles" FontFamily="{StaticResource Title}" FontSize="17"
                           Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="NewsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource ParchDark}" BorderThickness="0,0,0,1" Padding="0,6,8,8">
                          <StackPanel>
                            <TextBlock FontFamily="{StaticResource Title}" FontSize="14" Foreground="{DynamicResource Accent}">
                              <Run Text="{Binding Title, Mode=OneWay}"/>
                              <Run Text="{Binding Date, Mode=OneWay}" Foreground="{StaticResource Ash}" FontSize="11"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
              <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock Text="Le cercle" FontFamily="{StaticResource Title}" FontSize="17" Foreground="{StaticResource Ink}"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="13 Citadins et 4 Étrangers cherchent le Démon et ses 4 Sbires. Le bien gagne quand le Démon meurt ; le mal, quand il ne reste que deux vivants."/>
                <TextBlock Text="Serveur" FontFamily="{StaticResource Title}" FontSize="17" Foreground="{StaticResource Ink}" Margin="0,14,0,0"/>
                <ComboBox x:Name="ServerPicker" Margin="0,4,0,4" SelectionChanged="ServerPicked"/>
                <TextBlock x:Name="ServerText" Style="{StaticResource Hint}"/>
                <TextBlock Text="Compte" FontFamily="{StaticResource Title}" FontSize="17" Foreground="{StaticResource Ink}" Margin="0,14,0,0"/>
                <TextBlock x:Name="AccountShort" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- Options du jeu -->
          <ScrollViewer x:Name="PageGame" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource H1}" Text="Options du jeu"/>
              <TextBlock Style="{StaticResource Hint}" Text="Appliquées à Minecraft au prochain lancement."/>
              <TextBlock Style="{StaticResource Label}" x:Name="RenderLabel"/>
              <Slider x:Name="RenderSlider" Minimum="2" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OptionChanged"/>
              <TextBlock Style="{StaticResource Label}" x:Name="FovLabel"/>
              <Slider x:Name="FovSlider" Minimum="30" Maximum="110" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OptionChanged"/>
              <TextBlock Style="{StaticResource Label}" x:Name="FpsLabel"/>
              <Slider x:Name="FpsSlider" Minimum="30" Maximum="260" IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="OptionChanged"/>
              <TextBlock Style="{StaticResource Label}" x:Name="VolumeLabel"/>
              <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OptionChanged"/>
              <TextBlock Style="{StaticResource Label}" Text="Taille de l'interface"/>
              <ComboBox x:Name="GuiScaleBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OptionChanged">
                <ComboBoxItem Content="Automatique"/>
                <ComboBoxItem Content="Petite (1)"/>
                <ComboBoxItem Content="Normale (2)"/>
                <ComboBoxItem Content="Grande (3)"/>
                <ComboBoxItem Content="Très grande (4)"/>
              </ComboBox>
              <TextBlock Style="{StaticResource Label}" Text="Langue du jeu"/>
              <ComboBox x:Name="LangBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OptionChanged">
                <ComboBoxItem Content="Français" Tag="fr_fr"/>
                <ComboBoxItem Content="English" Tag="en_us"/>
              </ComboBox>
              <CheckBox x:Name="FullscreenBox" Content="Plein écran" Checked="OptionChanged" Unchecked="OptionChanged"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Personnalisation -->
          <StackPanel x:Name="PageLook" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Personnalisation"/>
            <TextBlock Style="{StaticResource Label}" Text="Couleur d'accent"/>
            <WrapPanel x:Name="AccentPanel"/>
            <TextBlock Style="{StaticResource Label}" Text="Fond de la fenêtre"/>
            <WrapPanel x:Name="BackgroundPanel"/>
            <CheckBox x:Name="CloseOnLaunchBox" Content="Fermer le launcher quand le jeu démarre" Checked="LookChanged" Unchecked="LookChanged"/>
          </StackPanel>

          <!-- Réglages -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource H1}" Text="Réglages"/>
              <TextBlock Style="{StaticResource Label}" Text="Dépôt GitHub du mod (propriétaire/nom)"/>
              <TextBox x:Name="RepoBox" LostFocus="SettingsChanged"/>
              <TextBlock Style="{StaticResource Hint}" Text="Le launcher y lit la dernière version publiée et ses nouvelles."/>
              <TextBlock Style="{StaticResource Label}" Text="Adresse du serveur"/>
              <TextBox x:Name="ServerBox" LostFocus="SettingsChanged"/>
              <TextBlock Style="{StaticResource Hint}" Text="Laissez vide pour utiliser l'adresse annoncée par la version publiée."/>
              <TextBlock Style="{StaticResource Label}" Text="Serveurs enregistrés"/>
              <ListBox x:Name="SavedServersList" MinHeight="60" MaxHeight="140" Margin="0,4,0,4"/>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewServerName" ToolTip="Nom (ex. Serveur de Léa)"/>
                <TextBox x:Name="NewServerAddress" Grid.Column="2" ToolTip="Adresse (ex. valcombe.exemple.fr:25565)"/>
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Text="À gauche le nom, à droite l'adresse."/>
              <WrapPanel>
                <Button Style="{StaticResource Wax}" Content="Ajouter le serveur" Click="AddServer" Margin="0,0,8,8"/>
                <Button Style="{StaticResource Wax}" Content="Retirer la sélection" Click="RemoveServer" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Text="Choisissez ensuite le serveur sur l'accueil, sous « Serveur »."/>
              <TextBlock Style="{StaticResource Label}" Text="ID d'application Microsoft (connexion intégrée)"/>
              <TextBox x:Name="ClientIdBox" LostFocus="SettingsChanged"/>
              <TextBlock Style="{StaticResource Hint}" Text="À renseigner une fois l'application validée par Microsoft : le launcher se connecte et lance alors le jeu lui-même, sans Prism."/>
              <TextBlock Style="{StaticResource Label}" x:Name="MemoryLabel"/>
              <Slider x:Name="MemorySlider" Minimum="2" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SettingsChanged"/>
              <WrapPanel Margin="0,18,0,0">
                <Button Style="{StaticResource Wax}" Content="Ouvrir le dossier" Click="OpenFolder" Margin="0,0,8,8"/>
                <Button Style="{StaticResource Wax}" Content="Réparer l'installation" Click="RepairInstall" Margin="0,0,8,8"/>
                <Button Style="{StaticResource Wax}" Content="Rapport de plantage" Click="MakeCrashReport" Margin="0,0,8,8"
                        ToolTip="Rassemble les journaux du jeu dans une archive sur le Bureau, à envoyer à l'hôte."/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Compte -->
          <StackPanel x:Name="PageAccount" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Compte Minecraft"/>
            <TextBlock x:Name="AccountText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="La connexion se fait une seule fois avec votre compte Microsoft, puis elle est gardée en mémoire. Elle est assurée par Prism Launcher, installé discrètement dans le dossier du launcher."/>
            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource Wax}" Content="Connecter ou gérer mon compte" Click="ManageAccount" Margin="0,0,8,8"/>
              <Button Style="{StaticResource Wax}" x:Name="SignOutButton" Content="Se déconnecter" Click="SignOut" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBox x:Name="CodeBox" IsReadOnly="True" FontSize="26" FontFamily="Consolas" HorizontalAlignment="Left"
                     Visibility="Collapsed" Margin="0,6,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                       Text="Dans la fenêtre qui s'ouvre : Comptes → Ajouter Microsoft, suivez les étapes, puis fermez-la et revenez ici."/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Bas : état, progression et bouton Jouer -->
      <Grid Grid.Row="2" Margin="24,0,24,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Parch}" FontSize="13" Text="Prêt."/>
          <ProgressBar x:Name="Progress" Margin="0,6,0,0" Maximum="1"/>
        </StackPanel>
        <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource Play}" Content="JOUER" Click="Play"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
